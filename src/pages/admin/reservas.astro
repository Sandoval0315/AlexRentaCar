---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/admin-auth.js';
import { getImports, getPublicConfig } from '../../lib/data.js';

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const importsList = await getImports();
const publicConfig = getPublicConfig();
---

<AdminLayout
  title="Importaciones"
  currentPath="/admin/reservas"
  sessionEmail={session.email}
>
  <section class="crud-grid">
    <article class="editor-card">
      <div class="editor-card__header">
        <div>
          <span class="eyebrow">Nuevo caso</span>
          <h2>Subir importacion</h2>
        </div>
        <span class={`chip ${publicConfig.cloudinaryCloudName ? 'chip--ok' : ''}`}>
          {publicConfig.cloudinaryCloudName ? 'Subida directa' : 'Modo URL manual'}
        </span>
      </div>

      <form id="import-form" class="editor-form">
        <input type="hidden" name="id" />
        <div class="form-grid">
          <label>Titulo<input name="title" required /></label>
          <label>Cliente<input name="client_name" required /></label>
          <label>Marca<input name="brand" required /></label>
          <label>Modelo<input name="model" required /></label>
          <label>Anio<input name="year" type="number" min="1990" required /></label>
          <label>Precio<input name="price" type="number" min="0" required /></label>
          <label>Estado<input name="status" placeholder="En puerto, Entregado..." required /></label>
          <label>Condicion<input name="condition" placeholder="Excelente, Bueno..." required /></label>
          <label>Tiempo de transito (dias)<input name="transit_time_days" type="number" min="0" required /></label>
          <label>Medio de envio<input name="shipping_method" placeholder="Maritimo, Aereo..." required /></label>
          <label>Origen<input name="origin" required /></label>
          <label>Destino<input name="destination" required /></label>
          <label class="checkbox"><input name="featured" type="checkbox" /> Destacado</label>
        </div>

        <label>Resumen<textarea name="summary" rows="4"></textarea></label>
        <label>URLs de imagen<textarea name="imagesText" rows="3" placeholder="Una por linea"></textarea></label>
        {publicConfig.cloudinaryCloudName && (
          <label>Subir imagenes
            <input id="import-image-upload" type="file" accept="image/*" multiple />
          </label>
        )}

        <div class="form-actions">
          <button type="submit">Guardar importacion</button>
          <button type="button" class="button-secondary" id="import-form-reset">Limpiar</button>
        </div>
        <p id="import-form-message" class="form-message"></p>
      </form>
    </article>

    <article class="list-card">
      <div class="editor-card__header">
        <div>
          <span class="eyebrow">Casos publicados</span>
          <h2>Seguimiento</h2>
        </div>
        <strong id="import-count">{importsList.length}</strong>
      </div>

      <div id="import-list" class="list-stack"></div>
    </article>
  </section>

  <script is:inline define:vars={{ initialImports: importsList, publicConfig }}>
    // @ts-nocheck -- Panel CRUD con datos serializados por Astro.
    const items = [...initialImports];
    const form = document.getElementById('import-form');
    const list = document.getElementById('import-list');
    const count = document.getElementById('import-count');
    const message = document.getElementById('import-form-message');
    const resetButton = document.getElementById('import-form-reset');
    const uploadInput = document.getElementById('import-image-upload');

    const formatMoney = (value) => new Intl.NumberFormat('es-SV', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0
    }).format(Number(value || 0));

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
    })[character]);

    const safeImageUrl = (value) => {
      const candidate = String(value || '');
      if (candidate.startsWith('/')) return escapeHtml(candidate);
      try {
        const parsed = new URL(candidate);
        return ['http:', 'https:'].includes(parsed.protocol)
          ? escapeHtml(parsed.href)
          : '/img/ford-explorer1.jpg';
      } catch {
        return '/img/ford-explorer1.jpg';
      }
    };

    function resetForm() {
      form.reset();
      form.elements.id.value = '';
      message.textContent = '';
    }

    function render() {
      list.innerHTML = items.map((item) => `
        <article class="fleet-item">
          <img src="${safeImageUrl(item.images?.[0])}" alt="${escapeHtml(item.title)}" />
          <div class="fleet-item__body">
            <div>
              <strong>${escapeHtml(item.title)}</strong>
              <p>${escapeHtml(item.status)} · ${escapeHtml(item.shipping_method)}</p>
            </div>
            <span>${escapeHtml(item.transit_time_days)} dias · ${formatMoney(item.price)}</span>
          </div>
          <div class="fleet-item__actions">
            <button type="button" data-edit="${escapeHtml(item.id)}">Editar</button>
            <button type="button" data-delete="${escapeHtml(item.id)}" class="danger">Eliminar</button>
          </div>
        </article>
      `).join('');
      count.textContent = String(items.length);
    }

    async function uploadFiles(files) {
      if (!files.length) return [];
      if (!publicConfig.cloudinaryCloudName) {
        message.textContent = 'Cloudinary no esta completo. Usa URLs manuales o termina la configuracion del servidor.';
        return [];
      }

      const urls = [];
      for (const file of files) {
        const payload = new FormData();
        payload.append('file', file);

        const response = await fetch('/api/admin/upload', {
          method: 'POST',
          body: payload
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error?.message || 'No se pudo subir imagen.');
        urls.push(data.secure_url);
      }
      return urls;
    }

    function fillForm(item) {
      form.elements.id.value = item.id;
      form.elements.title.value = item.title;
      form.elements.client_name.value = item.client_name;
      form.elements.brand.value = item.brand;
      form.elements.model.value = item.model;
      form.elements.year.value = item.year;
      form.elements.price.value = item.price;
      form.elements.status.value = item.status;
      form.elements.condition.value = item.condition;
      form.elements.transit_time_days.value = item.transit_time_days;
      form.elements.shipping_method.value = item.shipping_method;
      form.elements.origin.value = item.origin;
      form.elements.destination.value = item.destination;
      form.elements.featured.checked = Boolean(item.featured);
      form.elements.summary.value = item.summary || '';
      form.elements.imagesText.value = (item.images || []).join('\n');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.textContent = 'Guardando...';

      const data = new FormData(form);
      const manualUrls = String(data.get('imagesText') || '').split('\n').map((item) => item.trim()).filter(Boolean);

      try {
        const uploadedUrls = await uploadFiles(Array.from(uploadInput?.files || []));
        const payload = {
          title: String(data.get('title') || ''),
          client_name: String(data.get('client_name') || ''),
          brand: String(data.get('brand') || ''),
          model: String(data.get('model') || ''),
          year: Number(data.get('year') || 0),
          price: Number(data.get('price') || 0),
          status: String(data.get('status') || ''),
          condition: String(data.get('condition') || ''),
          transit_time_days: Number(data.get('transit_time_days') || 0),
          shipping_method: String(data.get('shipping_method') || ''),
          origin: String(data.get('origin') || ''),
          destination: String(data.get('destination') || ''),
          featured: data.get('featured') === 'on',
          summary: String(data.get('summary') || ''),
          images: [...manualUrls, ...uploadedUrls]
        };

        const id = String(data.get('id') || '');
        const response = await fetch(id ? `/api/admin/imports/${id}` : '/api/admin/imports', {
          method: id ? 'PATCH' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const saved = await response.json();
        if (!response.ok) throw new Error(saved.error || 'No se pudo guardar.');

        const index = items.findIndex((entry) => entry.id === saved.id);
        if (index >= 0) items[index] = saved;
        else items.unshift(saved);
        render();
        resetForm();
        message.textContent = 'Importacion guardada.';
      } catch (error) {
        message.textContent = error.message;
      }
    });

    list?.addEventListener('click', async (event) => {
      const editId = event.target.getAttribute('data-edit');
      const deleteId = event.target.getAttribute('data-delete');

      if (editId) {
        const item = items.find((entry) => entry.id === editId);
        if (item) fillForm(item);
      }

      if (deleteId) {
        const confirmed = window.confirm('Eliminar esta importacion?');
        if (!confirmed) return;
        const response = await fetch(`/api/admin/imports/${deleteId}`, { method: 'DELETE' });
        if (!response.ok) {
          message.textContent = 'No se pudo eliminar.';
          return;
        }
        const index = items.findIndex((entry) => entry.id === deleteId);
        items.splice(index, 1);
        render();
        message.textContent = 'Importacion eliminada.';
      }
    });

    resetButton?.addEventListener('click', resetForm);
    render();
  </script>
</AdminLayout>

<style>
  .crud-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1rem;
  }

  .editor-card,
  .list-card {
    background: rgba(255, 255, 255, 0.82);
    border-radius: 26px;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.07);
  }

  .editor-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .eyebrow {
    display: block;
    color: #dc2626;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    margin-bottom: 0.35rem;
  }

  .chip {
    background: #111827;
    color: #fff;
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    font-size: 0.75rem;
  }

  .chip--ok {
    background: #166534;
  }

  .editor-form,
  .form-grid {
    display: grid;
    gap: 0.9rem;
  }

  .form-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .editor-form label {
    display: grid;
    gap: 0.45rem;
    color: #374151;
    font-size: 0.92rem;
  }

  .editor-form input,
  .editor-form textarea,
  .fleet-item__actions button {
    font: inherit;
  }

  .editor-form input,
  .editor-form textarea {
    border: 1px solid #d1d5db;
    border-radius: 16px;
    padding: 0.9rem 1rem;
    background: #fff;
  }

  .checkbox {
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.7rem;
  }

  .form-actions {
    display: flex;
    gap: 0.8rem;
  }

  .form-actions button {
    border: 0;
    border-radius: 16px;
    padding: 0.95rem 1.2rem;
    background: linear-gradient(135deg, #dc2626, #f97316);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .button-secondary {
    background: #e5e7eb !important;
    color: #111827 !important;
  }

  .form-message {
    min-height: 1.5rem;
    color: #dc2626;
  }

  .list-stack {
    display: grid;
    gap: 0.8rem;
  }

  .fleet-item {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    background: #fff;
    border-radius: 22px;
    padding: 0.75rem;
  }

  .fleet-item img {
    width: 92px;
    height: 92px;
    object-fit: cover;
    border-radius: 18px;
  }

  .fleet-item__body p {
    color: #6b7280;
  }

  .fleet-item__actions {
    display: grid;
    gap: 0.5rem;
  }

  .fleet-item__actions button {
    border: 0;
    border-radius: 999px;
    padding: 0.7rem 0.9rem;
    background: #111827;
    color: #fff;
    cursor: pointer;
  }

  .fleet-item__actions .danger {
    background: #fee2e2;
    color: #991b1b;
  }

  @media (max-width: 900px) {
    .crud-grid,
    .form-grid,
    .fleet-item {
      grid-template-columns: 1fr;
    }

    .fleet-item img {
      width: 100%;
      height: 180px;
    }

    .fleet-item__actions {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
