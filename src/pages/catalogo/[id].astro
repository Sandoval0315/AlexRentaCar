---
import MainLayout from '../../layouts/MainLayout.astro';
import { categoryLabel, fuelLabel, getRentalById, transmissionLabel } from '../../lib/data.js';

const { id } = Astro.params;
const car = await getRentalById(id);

if (!car) {
  return Astro.redirect('/catalogo');
}
---

<MainLayout title={`${car.brand} ${car.model} - Alex Renta Cars`}>
  <section class="car-detail">
    <div class="car-detail__container">
      <nav class="car-detail__breadcrumb">
        <a href="/catalogo" class="car-detail__breadcrumb-link">Catalogo</a>
        <span>/</span>
        <span>{car.brand} {car.model}</span>
      </nav>

      <div class="car-detail__content">
        <div class="car-detail__gallery">
          <div class="car-detail__main-image">
            <img src={car.images[0] || '/img/toyota-corolla-2023-1.jpg'} alt={`${car.brand} ${car.model}`} class="car-detail__image" id="main-image" />
          </div>
          <div class="car-detail__thumbnails">
            {car.images.map((image, index) => (
              <button class="car-detail__thumbnail" type="button" data-image={image} aria-label={`Imagen ${index + 1}`}>
                <img src={image} alt={`${car.brand} ${car.model} ${index + 1}`} class="car-detail__thumbnail-image" />
              </button>
            ))}
          </div>
        </div>

        <div class="car-detail__info">
          <div class="car-detail__header">
            <div class="car-detail__title-section">
              <h1 class="car-detail__title">{car.brand} {car.model}</h1>
              <div class="car-detail__meta">
                <span class="car-detail__year">{car.year}</span>
                <span class={`car-detail__availability ${car.available ? 'car-detail__availability--available' : 'car-detail__availability--unavailable'}`}>
                  {car.status}
                </span>
              </div>
            </div>
            <div class="car-detail__price">
              <span class="car-detail__price-amount">${car.price_per_day}</span>
              <span class="car-detail__price-period">/dia</span>
            </div>
          </div>

          <p class="car-detail__description">{car.description}</p>

          <div class="car-detail__specs">
            <h3 class="car-detail__section-title">Especificaciones</h3>
            <div class="car-detail__specs-grid">
              <div class="car-detail__spec-item">
                <span class="car-detail__spec-label">Categoria</span>
                <span class="car-detail__spec-value">{categoryLabel(car.category)}</span>
              </div>
              <div class="car-detail__spec-item">
                <span class="car-detail__spec-label">Transmision</span>
                <span class="car-detail__spec-value">{transmissionLabel(car.transmission)}</span>
              </div>
              <div class="car-detail__spec-item">
                <span class="car-detail__spec-label">Combustible</span>
                <span class="car-detail__spec-value">{fuelLabel(car.fuel_type)}</span>
              </div>
              <div class="car-detail__spec-item">
                <span class="car-detail__spec-label">Capacidad</span>
                <span class="car-detail__spec-value">{car.seats} pasajeros</span>
              </div>
            </div>
          </div>

          <div class="car-detail__features">
            <h3 class="car-detail__section-title">Caracteristicas</h3>
            <div class="car-detail__features-grid">
              {car.features.map((feature) => (
                <div class="car-detail__feature">
                  <span>•</span>
                  <span>{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="car-detail__booking">
            <h3 class="car-detail__section-title">Reservar este vehiculo</h3>
            <form class="car-detail__booking-form" id="rental-request-form" data-daily-price={car.price_per_day}>
              <input type="hidden" name="rental_id" value={car.id} />
              <div class="car-detail__form-row">
                <div class="car-detail__form-group">
                  <label for="startDate" class="car-detail__form-label">Fecha de inicio</label>
                  <input type="date" id="startDate" name="startDate" class="car-detail__form-input" required />
                </div>
                <div class="car-detail__form-group">
                  <label for="endDate" class="car-detail__form-label">Fecha de fin</label>
                  <input type="date" id="endDate" name="endDate" class="car-detail__form-input" required />
                </div>
              </div>

              <div class="car-detail__form-group">
                <label for="customerName" class="car-detail__form-label">Nombre completo</label>
                <input type="text" id="customerName" name="customerName" class="car-detail__form-input" required />
              </div>

              <div class="car-detail__form-row">
                <div class="car-detail__form-group">
                  <label for="customerEmail" class="car-detail__form-label">Email</label>
                  <input type="email" id="customerEmail" name="customerEmail" class="car-detail__form-input" required />
                </div>
                <div class="car-detail__form-group">
                  <label for="customerPhone" class="car-detail__form-label">Telefono</label>
                  <input type="tel" id="customerPhone" name="customerPhone" class="car-detail__form-input" required />
                </div>
              </div>

              <div class="car-detail__form-group">
                <label for="notes" class="car-detail__form-label">Notas</label>
                <textarea id="notes" name="notes" class="car-detail__form-textarea" rows="3"></textarea>
              </div>

              <button type="submit" class="car-detail__submit-button" disabled={!car.available}>
                {car.available ? 'Solicitar reserva' : 'No disponible'}
              </button>
              <p class="car-detail__estimate" id="rental-estimate"></p>
              <p class="car-detail__form-message" id="rental-request-message"></p>
            </form>
          </div>
        </div>
      </div>
    </div>
	  </section>

  <script>
    // @ts-nocheck -- Interacciones del formulario y galería en el navegador.
    const bookingForm = document.getElementById('rental-request-form');
    const bookingMessage = document.getElementById('rental-request-message');
    const mainImage = document.getElementById('main-image');
    const estimate = document.getElementById('rental-estimate');
    const startDate = document.getElementById('startDate');
    const endDate = document.getElementById('endDate');
    const dailyPrice = Number(bookingForm?.dataset.dailyPrice || 0);

    const today = new Date().toISOString().slice(0, 10);
    startDate?.setAttribute('min', today);
    endDate?.setAttribute('min', today);

    function updateEstimate() {
      const start = startDate?.value;
      const end = endDate?.value;
      if (start) endDate?.setAttribute('min', start);
      if (!start || !end || end < start) {
        estimate.textContent = '';
        return;
      }
      const days = Math.max(1, Math.ceil((new Date(`${end}T00:00:00`) - new Date(`${start}T00:00:00`)) / 86400000));
      estimate.textContent = `Estimado: $${(dailyPrice * days).toFixed(2)} por ${days} día${days === 1 ? '' : 's'}.`;
    }

    startDate?.addEventListener('change', updateEstimate);
    endDate?.addEventListener('change', updateEstimate);

    document.querySelectorAll('[data-image]').forEach((button) => {
      button.addEventListener('click', () => {
        const image = button.getAttribute('data-image');
        if (image && mainImage instanceof HTMLImageElement) mainImage.src = image;
      });
    });

    bookingForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      bookingMessage.textContent = 'Enviando solicitud...';

      const formData = new FormData(bookingForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/rental-requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'No se pudo enviar la solicitud.');
        }

        bookingForm.reset();
        estimate.textContent = '';
        bookingMessage.innerHTML = `Solicitud recibida. Guarda tu código <strong>${data.request_code}</strong>. <a href="/solicitud?codigo=${encodeURIComponent(data.request_code)}">Consultar estado</a>.`;
      } catch (error) {
        bookingMessage.textContent = error.message;
      }
    });
  </script>
</MainLayout>
