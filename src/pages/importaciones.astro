---
import MainLayout from '../layouts/MainLayout.astro';
import { formatCurrency, getImports } from '../lib/data.js';

const imports = await getImports();
---

<MainLayout title="Importaciones - Alex Renta Cars">
  <section class="imports-hero">
    <div class="imports-hero__content">
      <span class="imports-hero__eyebrow">Casos reales</span>
      <h1>Importaciones administradas desde el panel</h1>
      <p>
        Cada vehiculo mostrado aqui sale del admin: fotos, estado actual, tiempo de transito
        y medio de envio. Todo pensado para verse impecable en telefono.
      </p>
    </div>
  </section>

  <section class="imports-grid">
    {imports.map((item) => (
      <article class="import-card">
        <div class="import-card__image">
          <img src={item.images[0] || '/img/ford-explorer1.jpg'} alt={item.title} />
          <span>{item.status}</span>
        </div>
        <div class="import-card__content">
          <div class="import-card__header">
            <div>
              <h2>{item.title}</h2>
              <p>{item.brand} {item.model} · {item.year}</p>
            </div>
            <strong>{formatCurrency(item.price)}</strong>
          </div>

          <p class="import-card__summary">{item.summary}</p>

          <dl class="import-card__meta">
            <div>
              <dt>Cliente</dt>
              <dd>{item.client_name}</dd>
            </div>
            <div>
              <dt>Condicion</dt>
              <dd>{item.condition}</dd>
            </div>
            <div>
              <dt>Tiempo</dt>
              <dd>{item.transit_time_days} dias</dd>
            </div>
            <div>
              <dt>Medio</dt>
              <dd>{item.shipping_method}</dd>
            </div>
            <div>
              <dt>Ruta</dt>
              <dd>{item.origin} a {item.destination}</dd>
            </div>
          </dl>
        </div>
      </article>
    ))}
  </section>
</MainLayout>

<style>
  .imports-hero {
    padding: 4.5rem 1.25rem 2rem;
    background:
      radial-gradient(circle at top left, rgba(249, 115, 22, 0.18), transparent 22%),
      linear-gradient(135deg, #111827, #1f2937 55%, #7f1d1d);
    color: #fff;
  }

  .imports-hero__content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .imports-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #fdba74;
    font-size: 0.72rem;
  }

  .imports-hero h1 {
    margin: 0.8rem 0;
    font-size: clamp(2rem, 6vw, 4rem);
    max-width: 800px;
  }

  .imports-hero p {
    max-width: 680px;
    color: #e5e7eb;
  }

  .imports-grid {
    max-width: 1100px;
    margin: -2rem auto 4rem;
    padding: 0 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .import-card {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    background: #fff;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.1);
  }

  .import-card__image {
    position: relative;
    min-height: 280px;
  }

  .import-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .import-card__image span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.84);
    color: #fff;
    padding: 0.5rem 0.85rem;
    font-size: 0.8rem;
  }

  .import-card__content {
    padding: 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .import-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }

  .import-card__header h2 {
    margin-bottom: 0.35rem;
  }

  .import-card__header p,
  .import-card__summary,
  .import-card__meta dt {
    color: #6b7280;
  }

  .import-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .import-card__meta div {
    background: #f8fafc;
    border-radius: 18px;
    padding: 0.9rem 1rem;
  }

  .import-card__meta dt {
    font-size: 0.8rem;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 800px) {
    .import-card {
      grid-template-columns: 1fr;
    }

    .imports-grid {
      margin-top: -1.2rem;
    }

    .import-card__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
