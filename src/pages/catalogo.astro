---
import MainLayout from '../layouts/MainLayout.astro';
import { getRentals } from '../lib/data.js';

const allCars = await getRentals();
const searchQuery = String(Astro.url.searchParams.get('search') || '').trim().toLowerCase();
const cars = searchQuery
  ? allCars.filter((car) => `${car.brand} ${car.model} ${car.year} ${car.category}`.toLowerCase().includes(searchQuery))
  : allCars;
---

<MainLayout title="Catalogo - Alex Renta Cars">
  <section class="catalog">
    <div class="catalog__container">
      <div class="catalog__header">
        <h1 class="catalog__title">Nuestra flota disponible</h1>
        <p class="catalog__subtitle">
          Los vehiculos de esta pagina salen del admin para que puedas publicar, editar o quitar
          unidades sin tocar codigo.
        </p>

        <button class="catalog__filters-toggle" id="filters-toggle" type="button">
          Mostrar filtros
        </button>

        <div class="catalog__filters" id="filters-container">
          <div class="filter-group">
            <label for="category" class="filter-label">Categoria</label>
            <select id="category" class="filter-select">
              <option value="">Todas</option>
              <option value="sedan">Sedan</option>
              <option value="suv">SUV</option>
              <option value="compacto">Compacto</option>
              <option value="deportivo">Deportivo</option>
              <option value="van">Van</option>
              <option value="pickup">Pickup</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="transmission" class="filter-label">Transmision</label>
            <select id="transmission" class="filter-select">
              <option value="">Cualquiera</option>
              <option value="automatica">Automatica</option>
              <option value="manual">Manual</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="price" class="filter-label">Precio maximo</label>
            <select id="price" class="filter-select">
              <option value="">Sin limite</option>
              <option value="35">Hasta $35/dia</option>
              <option value="50">Hasta $50/dia</option>
              <option value="70">Hasta $70/dia</option>
              <option value="100">Hasta $100/dia</option>
            </select>
          </div>
          <button class="filters-apply" id="apply-filters" type="button">Aplicar</button>
        </div>
      </div>

      <div class="catalog__grid" id="catalog-grid">
        {cars.map((car) => (
          <a href={`/catalogo/${car.id}`} class="catalog-card">
            <div class="catalog-card__image">
              <img src={car.images[0] || '/img/toyota-corolla-2023-1.jpg'} alt={`${car.brand} ${car.model}`} />
              {!car.available && <span>No disponible</span>}
            </div>
            <div class="catalog-card__content">
              <div class="catalog-card__top">
                <div>
                  <h2>{car.brand} {car.model}</h2>
                  <p>{car.year} · {car.category}</p>
                </div>
                <strong>${car.price_per_day}<small>/dia</small></strong>
              </div>
              <div class="catalog-card__specs">
                <span>{car.transmission}</span>
                <span>{car.seats} asientos</span>
                <span>{car.fuel_type}</span>
              </div>
              <p class="catalog-card__description">{car.description}</p>
            </div>
          </a>
        ))}
      </div>
      {cars.length === 0 && <p class="catalog__empty">No encontramos vehículos con ese criterio.</p>}
    </div>
  </section>

  <script is:inline define:vars={{ cars }}>
    // @ts-nocheck -- Datos serializados por Astro para filtros del navegador.
    const source = [...cars];
    const grid = document.getElementById('catalog-grid');
    const category = document.getElementById('category');
    const transmission = document.getElementById('transmission');
    const price = document.getElementById('price');
    const filtersContainer = document.getElementById('filters-container');
    const filtersToggle = document.getElementById('filters-toggle');
    const applyButton = document.getElementById('apply-filters');

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
    })[character]);

    const safeImageUrl = (value) => {
      const candidate = String(value || '');
      if (candidate.startsWith('/')) return escapeHtml(candidate);
      try {
        const parsed = new URL(candidate);
        return ['http:', 'https:'].includes(parsed.protocol)
          ? escapeHtml(parsed.href)
          : '/img/toyota-corolla-2023-1.jpg';
      } catch {
        return '/img/toyota-corolla-2023-1.jpg';
      }
    };

    function render(items) {
      grid.innerHTML = items.map((car) => `
        <a href="/catalogo/${encodeURIComponent(car.id)}" class="catalog-card">
          <div class="catalog-card__image">
            <img src="${safeImageUrl(car.images?.[0])}" alt="${escapeHtml(car.brand)} ${escapeHtml(car.model)}" />
            ${car.available ? '' : '<span>No disponible</span>'}
          </div>
          <div class="catalog-card__content">
            <div class="catalog-card__top">
              <div>
                <h2>${escapeHtml(car.brand)} ${escapeHtml(car.model)}</h2>
                <p>${escapeHtml(car.year)} · ${escapeHtml(car.category)}</p>
              </div>
              <strong>$${escapeHtml(car.price_per_day)}<small>/dia</small></strong>
            </div>
            <div class="catalog-card__specs">
              <span>${escapeHtml(car.transmission)}</span>
              <span>${escapeHtml(car.seats)} asientos</span>
              <span>${escapeHtml(car.fuel_type)}</span>
            </div>
            <p class="catalog-card__description">${escapeHtml(car.description || '')}</p>
          </div>
        </a>
      `).join('');
    }

    function applyFilters() {
      const items = source.filter((car) => {
        const byCategory = !category.value || car.category === category.value;
        const byTransmission = !transmission.value || car.transmission === transmission.value;
        const byPrice = !price.value || Number(car.price_per_day) <= Number(price.value);
        return byCategory && byTransmission && byPrice;
      });
      render(items);
    }

    filtersToggle?.addEventListener('click', () => {
      filtersContainer?.classList.toggle('is-open');
    });

    applyButton?.addEventListener('click', applyFilters);
  </script>
</MainLayout>

<style>
  .catalog {
    padding: 3rem 0 4rem;
    min-height: 80vh;
  }

  .catalog__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .catalog__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .catalog__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 0.9rem;
  }

  .catalog__subtitle {
    max-width: 700px;
    margin: 0 auto 1.4rem;
    color: #6b7280;
  }

  .catalog__filters-toggle {
    display: none;
    border: 0;
    border-radius: 999px;
    background: #111827;
    color: #fff;
    padding: 0.9rem 1.1rem;
    font: inherit;
    font-weight: 700;
  }

  .catalog__filters {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .filter-group {
    display: grid;
    gap: 0.45rem;
    text-align: left;
  }

  .filter-label {
    font-size: 0.85rem;
    color: #374151;
  }

  .filter-select,
  .filters-apply {
    border: 1px solid #d1d5db;
    border-radius: 16px;
    padding: 0.85rem 1rem;
    background: #fff;
    font: inherit;
  }

  .filters-apply {
    border: 0;
    background: linear-gradient(135deg, #dc2626, #f97316);
    color: #fff;
    align-self: end;
    cursor: pointer;
    font-weight: 700;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .catalog-card {
    display: block;
    background: #fff;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 20px 55px rgba(15, 23, 42, 0.09);
    color: inherit;
    text-decoration: none;
  }

  .catalog-card__image {
    position: relative;
    height: 220px;
  }

  .catalog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .catalog-card__image span {
    position: absolute;
    top: 1rem;
    right: 1rem;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.85);
    color: #fff;
    font-size: 0.78rem;
    padding: 0.45rem 0.7rem;
  }

  .catalog-card__content {
    padding: 1.2rem;
    display: grid;
    gap: 0.8rem;
  }

  .catalog-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .catalog-card__top p,
  .catalog-card__description {
    color: #6b7280;
  }

  .catalog-card__top strong {
    color: #dc2626;
    font-size: 1.4rem;
  }

  .catalog-card__top small {
    font-size: 0.78rem;
    color: #9ca3af;
    display: block;
    text-align: right;
  }

  .catalog-card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .catalog-card__specs span {
    background: #f3f4f6;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .catalog__filters-toggle {
      display: inline-flex;
      margin-bottom: 1rem;
    }

    .catalog__filters {
      display: none;
      background: #fff;
      padding: 1rem;
      border-radius: 20px;
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    .catalog__filters.is-open {
      display: grid;
    }

    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
